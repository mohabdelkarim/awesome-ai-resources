# Copy to .env and fill in real values. Never commit .env.
# cp .env.example .env

# Groq (required for auto-repair of dead links)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Telegram notification after each link check run
# 1) Message @BotFather -> /newbot -> copy token
# 2) Message your bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional override
REPO_URL=https://github.com/mohabdelkarim/awesome-ai-resources
